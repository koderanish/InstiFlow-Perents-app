# InstiFlow Parents app environment configuration.
# Copy this file to `.env` (never commit `.env`).

# Root URL of the InstiFlow backend (no trailing slash, no /api suffix).
EXPO_PUBLIC_API_URL=https://insti-flow-backend.vercel.app

# development | staging | production (EAS build profiles set this automatically).
EXPO_PUBLIC_APP_ENV=development

# Optional. Google Maps key for the live bus map in Android builds (not needed for Expo Go or iOS).
# GOOGLE_MAPS_API_KEY=
